{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autodiscover-honeypot",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "build/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "READ_ONLY": "true",
    "STAGING": "false"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "autodiscover-honeypot-staging",
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "READ_ONLY": "false",
        "STAGING": "true"
      }
    }
  }
}
